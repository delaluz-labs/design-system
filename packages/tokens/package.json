{
  "name": "@delaluz/tokens",
  "version": "0.0.0",
  "description": "Multi-platform design tokens for De la Luz Labs.",
  "author": "Eduardo de la Luz Nicolás",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./css": "./dist/css/index.css",
    "./json": "./dist/json/tokens.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "tokens:validate": "node ./scripts/validate.mjs",
    "themes:validate": "node ./scripts/validate-themes.mjs",
    "build:tokens": "node ./scripts/build.mjs",
    "build": "npm run clean && npm run tokens:validate && npm run themes:validate && npm run build:tokens && npm run validate:css",
    "build:determinism": "node ./scripts/build/validate-determinism.mjs",
    "build:css-entrypoint": "node scripts/build/run-css-entrypoint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate:css": "node scripts/validate-css-themes.mjs"
  },
  "keywords": [],
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.0",
    "style-dictionary": "5.5.3"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  }
}
